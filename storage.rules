rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Authenticated users may read only their own files.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Validate the uploaded object only on writes. request.resource is not
      // available for normal reads, so keep this condition out of allow read.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 500 * 1024 * 1024;
    }
  }
}
